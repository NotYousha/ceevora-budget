# Backend environment. Copy to /etc/ceevora-budget/env (production) and fill from your secret store.
# Never commit real values. Never put any of these in the Flutter app.

# Token signing secret: 48+ random bytes, rotate on compromise (rotating signs everyone out).
JWT_SECRET=
TOKEN_TTL_MINUTES=60

# Comma-separated browser origins allowed to call the API (exact match). Empty = localhost only.
CORS_ORIGINS=https://budget.example.com

# Server-side tenant registry. Each tenant entry names the env vars holding its PDB credentials.
CEEVORA_TENANTS_FILE=/etc/ceevora-budget/tenants.json

# Example tenant "ACME" (names referenced from tenants.json). DSN = private PDB service, port 1521 not public.
ACME_DB_USER=BUDGET_APP
ACME_DB_PASSWORD=
ACME_DB_DSN=db-private.example.internal:1521/ACMEPDB.example

# Optional
LOG_LEVEL=INFO
WEB_DIR=/opt/ceevora-budget/web
